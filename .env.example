# Use a private service environment file; never commit real credentials.
NODE_ENV=production
HOST=127.0.0.1
PORT=4321
SITE_URL=https://dyyjs.com
PUBLIC_BASE_PATH=/howielog
DATABASE_PATH=/var/lib/dev-blog/data.db
MEDIA_DIR=/var/lib/dev-blog/media
FULL_BACKUP_DIR=/var/lib/dev-blog/full-backups
# ADMIN_PASSWORD_HASH=<bcrypt hash configured privately>
# Passkeys use this exact HTTPS origin. Default: SITE_URL.
WEBAUTHN_ORIGIN=https://dyyjs.com
# Optional Chinese-capable font file for generated social cards.
# SHARE_CARD_FONT_FILE=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# Optional encrypted backups. Initialize the repository using restic first.
# RESTIC_BINARY=/usr/bin/restic
# RESTIC_REPOSITORY=sftp:backup-host:/srv/backups/howielog
# RESTIC_PASSWORD_FILE=/etc/dev-blog/restic-password
# RESTIC_CACHE_DIR=/var/lib/dev-blog/restic-cache
# SSH keys and known_hosts must be accessible to the service account.
