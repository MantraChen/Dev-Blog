---
import { withBase, contentUrl, THEME_STORAGE_KEY } from "@/lib/site-path";
import "@/styles/globals.css"
import "katex/dist/katex.min.css"
import "@fontsource-variable/geist"
import Nav from "./Nav.astro"
import { QuickSearch } from '@/components/blog/QuickSearch';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  canonicalPath?: string;
  article?: { publishedAt: string; updatedAt?: string | null };
}

const { title, description = "Systems programming, engineering experiments, and project notes by Howie Sun.", ogImage = "/icon-512.png", noIndex = false, canonicalPath, article } = Astro.props;
const siteUrl = Astro.site || new URL("https://howielog.com/");
const canonicalUrl = new URL(withBase(canonicalPath || Astro.url.pathname), siteUrl);
const imageUrl = new URL(contentUrl(ogImage), siteUrl);
const isoDate = (value: string) => Number.isNaN(Date.parse(value)) ? undefined : new Date(value).toISOString();
const articleData = article && {
  "@context": "https://schema.org", "@type": "BlogPosting", headline: title.replace(/ \| Blog$/, ""),
  description, image: imageUrl.href, mainEntityOfPage: canonicalUrl.href,
  author: { "@type": "Person", name: "Howie Sun", url: new URL(withBase("/"), siteUrl).href },
  datePublished: isoDate(article.publishedAt), dateModified: isoDate(article.updatedAt || article.publishedAt),
};
if (!Astro.response.headers.has("Cache-Control")) Astro.response.headers.set("Cache-Control", "no-cache");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Howie Sun — RSS" href={withBase("/rss.xml")} />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {article && <meta property="article:published_time" content={isoDate(article.publishedAt)} />}
    {article && <meta property="article:modified_time" content={isoDate(article.updatedAt || article.publishedAt)} />}
    {articleData && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleData).replace(/</g, "\\u003c")} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" id="dynamic-favicon" type="image/svg+xml" href={withBase("/favicon.svg")} />
    <link rel="apple-touch-icon" sizes="180x180" href={withBase("/apple-touch-icon.png")} />

    <title>{title}</title>

    <script is:inline src={withBase("/theme.js")} data-storage-key={THEME_STORAGE_KEY}></script>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased flex flex-col">
    <Nav />
    <main class="flex-1 container mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t py-6 text-center text-sm text-muted-foreground">
      <div class="container mx-auto max-w-6xl px-4 flex flex-wrap gap-4 justify-between items-center">
        <p>&copy;
          {new Date().getFullYear()} Howie Sun. Content licensed under CC BY-NC 4.0.</p>
        <a href={withBase("/admin")} class="hover:text-foreground transition-colors">Std::abort()</a>
      </div>
      <div class="mx-auto mt-4 flex max-w-6xl flex-wrap items-center justify-center gap-5 px-4 text-sm"><a href={withBase('/series')}>Series</a><a href={withBase('/now')}>Now</a><a href={withBase('/review')}>Year in review</a><a href={withBase('/bookmarks')}>My bookmarks</a>{!Astro.url.pathname.startsWith(withBase('/admin'))&&<QuickSearch client:idle/>}</div>
    </footer>

    <button
      id="scroll-top"
      class="fixed bottom-6 right-6 z-50 h-10 w-10 rounded-full bg-primary text-primary-foreground shadow-lg flex items-center justify-center hover:bg-primary/90 opacity-0 pointer-events-none transition-opacity duration-200"
      aria-label="Scroll to top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <script>import "@/scripts/layout";</script>
    <script>import '@/scripts/content-enhancements';</script>
  </body>
</html>
