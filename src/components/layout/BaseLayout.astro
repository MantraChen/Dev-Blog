---
import "@/styles/globals.css"
import "katex/dist/katex.min.css"
import { ClientRouter } from "astro:transitions"
import Nav from "./Nav.astro"

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  canonicalPath?: string;
  article?: { publishedAt: string; updatedAt?: string | null };
}

const { title, description = "Systems programming, engineering experiments, and project notes by Howie Sun.", ogImage = "/icon-512.png", noIndex = false, canonicalPath, article } = Astro.props;
const siteUrl = Astro.site || new URL("https://howielog.com/");
const canonicalUrl = new URL(canonicalPath || Astro.url.pathname, siteUrl);
const imageUrl = new URL(ogImage, siteUrl);
const isoDate = (value: string) => Number.isNaN(Date.parse(value)) ? undefined : new Date(value).toISOString();
const articleData = article && {
  "@context": "https://schema.org", "@type": "BlogPosting", headline: title.replace(/ \| Blog$/, ""),
  description, image: imageUrl.href, mainEntityOfPage: canonicalUrl.href,
  author: { "@type": "Person", name: "Howie Sun", url: siteUrl.href },
  datePublished: isoDate(article.publishedAt), dateModified: isoDate(article.updatedAt || article.publishedAt),
};
if (!Astro.response.headers.has("Cache-Control")) Astro.response.headers.set("Cache-Control", "no-cache");
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" type="application/rss+xml" title="Howie Sun — RSS" href="/rss.xml" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    {article && <meta property="article:published_time" content={isoDate(article.publishedAt)} />}
    {article && <meta property="article:modified_time" content={isoDate(article.updatedAt || article.publishedAt)} />}
    {articleData && <script is:inline type="application/ld+json" set:html={JSON.stringify(articleData).replace(/</g, "\\u003c")} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />

    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" id="dynamic-favicon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <ClientRouter />

    <script is:inline>
      (function() {
        var darkFavicon = "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%231a1a2e'/><path d='M8 10l6 5-6 5' stroke='%23e2e8f0' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' fill='none'/><line x1='16' y1='22' x2='24' y2='22' stroke='%23e2e8f0' stroke-width='2.5' stroke-linecap='round'/></svg>";
        var lightFavicon = "data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' rx='6' fill='%23f1f5f9'/><path d='M8 10l6 5-6 5' stroke='%231e293b' stroke-width='2.5' stroke-linecap='round' stroke-linejoin='round' fill='none'/><line x1='16' y1='22' x2='24' y2='22' stroke='%231e293b' stroke-width='2.5' stroke-linecap='round'/></svg>";

        function updateFavicon(isDark) {
          var link = document.getElementById('dynamic-favicon');
          if (link) link.setAttribute('href', isDark ? darkFavicon : lightFavicon);
        }

        function applyTheme() {
          var savedTheme;
          try { savedTheme = localStorage.getItem('theme'); } catch {}
          var theme = savedTheme ||
            (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
          var isDark = theme === 'dark';
          document.documentElement.classList.toggle('dark', isDark);
          try { localStorage.setItem('theme', theme); } catch {}
          updateFavicon(isDark);
        }
        applyTheme();

        if (window.__blogThemeBound) return;
        window.__blogThemeBound = true;
        // Listen for theme changes from ThemeToggle component
        new MutationObserver(function() {
          updateFavicon(document.documentElement.classList.contains('dark'));
        }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });

        // Preserve theme across View Transitions
        document.addEventListener('astro:before-swap', function(e) {
          var isDark = document.documentElement.classList.contains('dark');
          e.newDocument.documentElement.classList.toggle('dark', isDark);
        });
      })();
    </script>
  </head>
  <body class="min-h-screen bg-background font-sans antialiased flex flex-col">
    <Nav />
    <main class="flex-1 container mx-auto max-w-6xl px-4 py-8">
      <slot />
    </main>
    <footer class="border-t py-6 text-center text-sm text-muted-foreground">
      <div class="container mx-auto max-w-6xl px-4 flex justify-between items-center">
        <p>&copy;
          {new Date().getFullYear()} Howie Sun. Content licensed under CC BY-NC 4.0.</p>
        <a href="/admin" class="hover:text-foreground transition-colors">Std::abort()</a>
      </div>
    </footer>

    <button
      id="scroll-top"
      class="fixed bottom-6 right-6 z-50 h-10 w-10 rounded-full bg-primary text-primary-foreground shadow-lg flex items-center justify-center hover:bg-primary/90 opacity-0 pointer-events-none transition-opacity duration-200"
      aria-label="Scroll to top"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m18 15-6-6-6 6"/></svg>
    </button>

    <script>import "@/scripts/layout";</script>
  </body>
</html>
