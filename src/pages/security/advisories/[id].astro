---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { securityDetail,securityDate,severityLabels } from '@/lib/security';
import { withBase } from '@/lib/site-path';
const item=securityDetail(Astro.params.id||'');
if(!item)return new Response('公告不存在。请返回 /security 搜索其他公告。',{status:404,headers:{'Content-Type':'text/plain; charset=utf-8'}});
if(item.id!==Astro.params.id)return Astro.redirect(withBase('/security/advisories/'+encodeURIComponent(item.id)),308);
const conflict=new Set(item.records.map(r=>r.severity).filter(x=>x!=='unknown')).size>1;
---
<BaseLayout title={`${item.id} · ${item.title} | 安全中心`} description={item.summary} language="zh-CN">
  <a class="text-sm text-muted-foreground hover:underline" href={withBase('/security')}>← 安全中心</a>
  <article class="py-8 space-y-8 max-w-4xl mx-auto">
    <header class="space-y-4"><div class="flex flex-wrap items-center gap-3 text-sm"><span class="font-mono">{item.id}</span><span class="rounded border px-2 py-1">{severityLabels[item.severity]||'未评级'}</span>{item.exploited&&<span class="rounded border border-red-500/50 text-red-500 px-2 py-1">KEV · 已知被利用</span>}{item.withdrawn&&<span class="rounded border px-2 py-1">公告已撤回</span>}</div><h1 class="text-3xl sm:text-4xl font-bold tracking-tight leading-tight break-words">{item.title}</h1><p class="text-sm text-muted-foreground">首次发布 {securityDate(item.published)} · 来源更新 {securityDate(item.modified)} · 北京时间</p><p class="font-mono text-xs text-muted-foreground break-words">{item.aliases.join(' · ')}</p></header>
    <section class="rounded-xl border bg-muted/30 p-5 space-y-3"><h2 class="text-lg font-semibold">中文要点</h2><p class="leading-7 break-words">{item.summary}</p><p class="text-xs text-muted-foreground">自动事实摘要 · 仅整理已公开记录，不代表本站复现、确认受影响或背书。版本与修复信息见下方来源记录。</p>{conflict&&<p class="text-sm text-amber-600">不同来源评级存在差异，以下分别列出，不将它们合成为新的评分。</p>}</section>
    <section class="space-y-4"><h2 class="text-2xl font-semibold">影响范围与修复节点</h2>{item.affected.length?item.affected.map(affected=><div class="rounded-xl border p-5 space-y-3 text-sm"><h3 class="font-semibold break-words">{affected.ecosystem} / {affected.package}</h3><p class="text-xs text-muted-foreground">来源：{affected.source} · {affected.record}</p>{affected.ranges.length?affected.ranges.map(range=><div class="space-y-2"><p class="text-muted-foreground">上游区间类型：{range.type}{range.repo?' · '+range.repo:''}</p><ul class="flex flex-wrap gap-2">{range.events.map(event=>Object.entries(event).map(([kind,value])=><li class="rounded bg-muted px-3 py-1 font-mono break-all">{{introduced:'引入',fixed:'修复',last_affected:'最后受影响',limit:'范围上限'}[kind]||kind}: {value==='0'&&kind==='introduced'?'上游未指定起点':value}</li>))}</ul></div>):<p class="text-muted-foreground">上游未提供结构化版本区间；请查看原始公告。</p>}{affected.versions.length>0&&<details><summary class="cursor-pointer text-muted-foreground">上游明确列出的版本（{affected.versions.length} 个）</summary><p class="mt-3 font-mono text-xs break-all">{affected.versions.join(', ')}</p></details>}<p class="text-xs text-muted-foreground">各事件按上游顺序原样展示；不同包或版本分支的修复节点不应混用。</p></div>):<p class="text-muted-foreground">来源未提供受影响组件。</p>}</section>
    <section class="space-y-4"><h2 class="text-2xl font-semibold">来源公告</h2>{item.records.map(record=><details class="rounded-xl border p-5" open={item.records.length===1}><summary class="cursor-pointer font-semibold break-words">{record.source} · {record.id}{record.withdrawn?' · 该来源已撤回':''}</summary><div class="mt-4 space-y-4 text-sm"><a href={record.url} class="underline break-all" rel="noopener noreferrer" target="_blank">查看原始记录 ↗</a><p class="text-muted-foreground">来源发布日期 {securityDate(record.published)} · 更新 {securityDate(record.modified)}</p>{record.withdrawn&&<p class="text-amber-600">撤回时间：{securityDate(record.withdrawn)}</p>}{record.kevAdded&&<p>KEV 收录：{record.kevAdded}（这是收录日期，不是漏洞公开日期）</p>}{record.assessments.length>0&&<ul class="space-y-2">{record.assessments.map(s=><li class="font-mono text-xs break-all">{s.source} / {s.type}: {s.value}</li>)}</ul>}{record.action&&<div><h3 class="font-semibold">CISA 原文处置建议</h3><p class="mt-2 whitespace-pre-wrap break-words leading-7">{record.action}</p></div>}<div><h3 class="font-semibold">原始描述（原文）</h3><p class="mt-2 whitespace-pre-wrap break-words leading-7 text-muted-foreground">{record.description||'上游未提供描述。'}</p></div>{record.references.length>0&&<details><summary class="cursor-pointer">参考链接</summary><ul class="mt-3 space-y-2">{record.references.map(url=><li><a href={url} target="_blank" rel="noopener noreferrer" class="underline break-all">{url}</a></li>)}</ul></details>}</div></details>)}</section>
    <p class="border-t pt-5 text-sm text-muted-foreground">发现资料错误时，请优先向原始公告维护者反馈。本站会在后续同步中更新内容；安全情报与本站独立研究公告分别发布。</p>
  </article>
</BaseLayout>
