---
import { withBase } from "@/lib/site-path";
import BaseLayout from "@/components/layout/BaseLayout.astro"
import { validateSession } from "@/lib/auth"

const isAuthenticated = await validateSession(Astro.request.headers.get("cookie"))
if (isAuthenticated) {
  return Astro.redirect(withBase("/admin"))
}
---

<BaseLayout title="Admin Login">
  <div class="flex items-center justify-center min-h-[60vh]">
    <div class="w-full max-w-sm space-y-6">
      <div class="text-center">
        <h1 class="text-2xl font-bold">Admin Login</h1>
        <p class="text-sm text-muted-foreground mt-2">Enter your password to continue</p>
      </div>
      <form id="login-form" class="space-y-4">
        <div>
          <label for="password" class="text-sm font-medium">Password</label>
          <input
            id="password"
            name="password"
            type="password"
            required
            class="flex h-10 w-full rounded-md border border-input bg-background px-3 py-2 text-sm ring-offset-background placeholder:text-muted-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 mt-1"
            placeholder="Enter admin password"
          />
        </div>
        <p id="error-msg" class="text-sm text-destructive hidden"></p>
        <button
          type="submit"
          class="inline-flex items-center justify-center rounded-md text-sm font-medium h-10 px-4 py-2 w-full bg-primary text-primary-foreground hover:bg-primary/90 transition-colors"
        >
          Login
        </button>
      </form>
      <button id="passkey-login" type="button" class="w-full rounded border px-4 py-2 text-sm">Sign in with a passkey</button>
    </div>
  </div>

  <script>
    import { withBase } from "@/lib/site-path";
    document.getElementById('passkey-login')!.addEventListener('click',async(event)=>{
      const button=event.currentTarget as HTMLButtonElement,error=document.getElementById('error-msg')!;
      button.disabled=true;error.classList.add('hidden');
      try {
        const {startAuthentication}=await import('@simplewebauthn/browser');
        const send=async(data:unknown)=>{const response=await fetch(withBase('/api/auth/passkey'),{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(data)});const result=await response.json();if(!response.ok)throw new Error(result.error||'Passkey sign-in failed');return result;};
        const options=await send({action:'login-options'});
        const response=await startAuthentication({optionsJSON:options.options});
        await send({action:'login-verify',challengeId:options.challengeId,response});location.href=withBase('/admin');
      }catch(e){error.textContent=e instanceof Error?e.message:'Passkey sign-in failed';error.classList.remove('hidden');}finally{button.disabled=false;}
    });
    document.getElementById('login-form')!.addEventListener('submit', async (e) => {
      e.preventDefault();
      const password = (document.getElementById('password') as HTMLInputElement).value;
      const errorMsg = document.getElementById('error-msg')!;
      errorMsg.classList.add('hidden');

      try {
        const res = await fetch(withBase('/api/auth/login'), {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ password }),
        });

        if (res.ok) {
          window.location.href = withBase('/admin');
        } else {
          const data = await res.json();
          errorMsg.textContent = data.error || 'Login failed';
          errorMsg.classList.remove('hidden');
        }
      } catch {
        errorMsg.textContent = 'Network error';
        errorMsg.classList.remove('hidden');
      }
    });
  </script>
</BaseLayout>
