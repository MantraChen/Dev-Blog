---
import { withBase } from "@/lib/site-path";
import BaseLayout from "@/components/layout/BaseLayout.astro"
import { validateSession } from "@/lib/auth"
import { AdminApp } from "@/components/admin/AdminApp"

const isAuthenticated = await validateSession(Astro.request.headers.get("cookie"))

if (!isAuthenticated) {
  return Astro.redirect(withBase("/admin/login"))
}
---

<BaseLayout title="Admin Dashboard">
  <div class="py-6">
    <div class="flex items-center justify-between mb-6">
      <h1 class="text-3xl font-bold tracking-tight">Admin Dashboard</h1>
      <button
        id="logout-btn"
        class="inline-flex items-center justify-center rounded-md text-sm font-medium h-9 px-4 border hover:bg-accent transition-colors"
      >
        Logout
      </button>
    </div>
    <AdminApp client:load />
  </div>

  <script>
    import { withBase } from "@/lib/site-path";
    import { clearEditorRecovery, BEFORE_EDITOR_LOGOUT } from "@/lib/editor-client";
    document.getElementById('logout-btn')!.addEventListener('click', async () => {
      if (!window.dispatchEvent(new Event(BEFORE_EDITOR_LOGOUT, { cancelable: true }))) return;
      try {
        const response = await fetch(withBase('/api/auth/logout'), { method: 'POST' });
        if (!response.ok) throw new Error('Sign out failed');
        clearEditorRecovery();
        window.location.href = withBase('/admin/login');
      } catch { alert('Unable to sign out. Please retry. Your browser recovery copies are preserved.'); }
    });
  </script>
</BaseLayout>
