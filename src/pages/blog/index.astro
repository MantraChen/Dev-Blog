---
import BaseLayout from "@/components/layout/BaseLayout.astro"
import { TagFilter } from "@/components/blog/TagFilter"
import { getPublicPostPage, getPublishedPostMetadata } from "@/db/queries"
import { toPostSummary } from "@/lib/post-summary"

const query = (Astro.url.searchParams.get("q") || "").trim().slice(0, 200)
const tag = (Astro.url.searchParams.get("tag") || "").trim().slice(0, 50)
const result = await getPublicPostPage({ query, tag, page: Number(Astro.url.searchParams.get("page") || 1) })
const metadata = await getPublishedPostMetadata()
const tagCounts: Record<string, number> = Object.create(null)
metadata.forEach(p => new Set(p.tags).forEach(t => { tagCounts[t] = (tagCounts[t] || 0) + 1 }))
const allTags = Object.keys(tagCounts).sort()
const params = new URLSearchParams()
if (query) params.set("q", query)
if (tag) params.set("tag", tag)
if (result.page > 1) params.set("page", String(result.page))
const canonicalPath = "/blog" + (params.size ? "?" + params : "")
---

<BaseLayout title="Blog | Tech Blog" description="Technical articles and notes" canonicalPath={canonicalPath} noIndex={!!query}>
  <div class="max-w-4xl mx-auto py-10 px-4 sm:px-6">
    <h1 class="text-3xl font-bold tracking-tight mb-8">Blog</h1>
    <TagFilter posts={result.posts.map(toPostSummary)} tags={allTags} tagCounts={tagCounts}
      initialQuery={query} initialTag={tag} initialPage={result.page} initialTotal={result.total} client:load />
  </div>
</BaseLayout>
